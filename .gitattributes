# Preview assets are binary containers: never let Git rewrite their bytes or
# line endings on checkout (a corrupted .env/glb/hdr fails at runtime only).
*.env binary
*.glb binary
*.hdr binary

# patch-package applies these byte-for-byte with `git apply`; a CRLF checkout
# (core.autocrlf=true on Windows) would change the context lines it matches.
patches/*.patch text eol=lf
