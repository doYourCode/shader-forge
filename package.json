{
  "name": "shaderforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run docs:abi",
    "build": "vue-tsc -b && vite build",
    "prebuild": "npm run docs:abi",
    "preview": "vite preview",
    "bake:env": "vite --open /bake.html",
    "bake:examples": "vite --open /example-thumb-bake.html",
    "docs:abi": "node scripts/generate-abi-docs.mjs",
    "docs:abi:check": "node scripts/generate-abi-docs.mjs --check",
    "docs:images": "node tools/docs/bake-lesson-images.mjs",
    "postinstall": "patch-package",
    "test": "vitest run",
    "pretest": "npm run docs:abi",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spector:capture": "node tools/spector/capture.mjs",
    "spector:analyze": "node tools/spector/analyze.mjs",
    "spector:control": "node tools/spector/capture.mjs --control"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.1",
    "@babylonjs/loaders": "^9.32.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@jaames/iro": "^5.5.2",
    "@lezer/highlight": "^1.2.5",
    "assetpicker": "github:netresearch/assetpicker#0de93d1da6de9ba01453d6b342993bcb92cf242a",
    "bulma": "^1.0.4",
    "codemirror": "^6.0.2",
    "codemirror-lang-glsl": "^0.5.0",
    "github-slugger": "^2.0.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "mermaid": "^12.2.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.9.10",
    "spectorjs": "^0.9.33",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
