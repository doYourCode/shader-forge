#version 300 es
precision highp float;

// Toon shading: quantise N dot L into a small number of bands.
// The result is not physically based, but the silhouette and the terminator
// stay readable, which is why it is useful for stylised previews.

in vec3 vWorldPosition;
in vec3 vWorldNormal;

uniform vec3 lightDir;

out vec4 fragColor;

void main(void)
{
    vec3 normal = normalize(vWorldNormal);
    float NdotL = max(dot(normal, normalize(lightDir)), 0.0);

    // `bands` and `albedo` are generated by the User data tab.
    float steps = max(bands, 1.0);
    float shade = floor(NdotL * steps) / steps;

    // A little ambient keeps the dark band from going fully black.
    vec3 color = albedo * (0.15 + 0.85 * shade);

    fragColor = vec4(color, 1.0);
}
